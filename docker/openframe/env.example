# Installer generates and preserves these values in .env (mode 600).
COMPOSE_PROJECT_NAME=openframe-example
OPENFRAME_SERVER_IMAGE=ghcr.io/ghoststack0/openframe-server:commit-REPLACE_WITH_FULL_SHA
OPENFRAME_ML_IMAGE=ghcr.io/ghoststack0/openframe-machine-learning:commit-REPLACE_WITH_FULL_SHA
OPENFRAME_PORT=2283
DB_HOSTNAME=database
DB_PORT=5432
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
REDIS_HOSTNAME=redis
IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003
